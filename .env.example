# Astro frontend (contact form → Supabase edge function)
# Copy to .env for local dev; set as GitHub repo secrets for production builds.

PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
PUBLIC_SUPABASE_CONTACT_FUNCTION=rapid-action

# --- Email & Telegram (NOT used by Astro) ---
# Those run server-side in the Supabase edge function.
# Configure them in supabase/functions/.env (local) or Supabase Dashboard → Secrets (production).
# See supabase/functions/.env.example
