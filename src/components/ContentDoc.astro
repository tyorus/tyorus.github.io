---
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from './Comments.astro';
import { site } from '../data/site';
import { absoluteUrl, articleSchema } from '../lib/schema';
import type { CollectionEntry } from 'astro:content';

type Entry = CollectionEntry<'blog'> | CollectionEntry<'projects'>;

interface Props {
  entry: Entry;
  Content: any;
  headings: { depth: number; slug: string; text: string }[];
  section: 'blog' | 'projects';
  sectionLabel: string;
}

const { entry, Content, headings, section, sectionLabel } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length > 1;
const pagePath = `/${section}/${entry.id}/`;
const pageUrl = absoluteUrl(pagePath);
const baseDescription = (entry.data.description || entry.data.title).trim();
const brandSuffix = ` — ${site.name} · ${site.title}`;
const description = baseDescription.includes(site.name)
  ? baseDescription
  : `${baseDescription}${brandSuffix}`;
const schemaType = section === 'projects' ? 'Article' : 'BlogPosting';
const keywords = [
  site.name,
  site.title,
  ...site.roles,
  ...entry.data.tags,
  ...entry.data.categories,
];
const bylineRoles = ['Data Engineer', 'Python Developer'] as const;
const docLang = entry.data.lang;
const langLabel = docLang === 'id' ? 'ID' : 'EN';
const isAutomationProject = section === 'projects' && entry.id === 'automated-reporting';
---

<BaseLayout
  fullTitle={`${entry.data.title} · ${site.name} · ${site.title}`}
  description={description}
  math={entry.data.math}
  ogType="article"
  publishedTime={entry.data.pubDate}
  modifiedTime={entry.data.updatedDate}
  schema={articleSchema({
    title: entry.data.title,
    description,
    url: pageUrl,
    datePublished: entry.data.pubDate,
    dateModified: entry.data.updatedDate,
    keywords,
    type: schemaType,
    inLanguage: docLang,
  })}
>
  <div class="site-shell doc-layout">
    <article class="doc-content" lang={docLang}>
      <h1 class="doc-title">{entry.data.title}</h1>
      <div class="post-meta">
        <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
        <span class="lang-badge" title={docLang === 'id' ? 'Bahasa Indonesia' : 'English'}
          >{langLabel}</span
        >
        {
          entry.data.categories.length > 0 && (
            <span>{entry.data.categories.join(' · ')}</span>
          )
        }
      </div>
      <p class="post-byline">
        By{' '}
        <a href="/resume">{site.name}</a>
        {' · '}
        {bylineRoles.join(' · ')}
      </p>

      {
        showToc && (
          <details class="doc-toc-mobile">
            <summary>On this page</summary>
            <ol>
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? 'toc-h3' : undefined}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <aside class="doc-cta" aria-label="Next steps">
        {
          isAutomationProject ? (
            <>
              <p class="doc-cta__lede">
                Need a similar weekly brief for your team? Selective freelance automation from
                production DE experience.
              </p>
              <div class="cta-row">
                <a class="btn btn--primary" href="/services">Freelance automation</a>
                <a class="btn btn--ghost" href={`mailto:${site.email}`}>Contact</a>
              </div>
            </>
          ) : (
            <>
              <p class="doc-cta__lede">
                More about my work as a Metocean Data Engineer, backend developer, and automation
                practitioner.
              </p>
              <div class="cta-row">
                <a class="btn btn--primary" href="/resume">View resume</a>
                <a class="btn btn--ghost" href={`mailto:${site.email}`}>Contact</a>
              </div>
            </>
          )
        }
      </aside>

      <Comments
        pageUrl={new URL(pagePath, site.url).href}
        pageId={`https://yothunder.github.io/posts/${entry.id}/`}
      />

      <p class="doc-back">
        <a href={`/${section}`}>← Back to {sectionLabel}</a>
      </p>
    </article>

    {
      showToc && (
        <aside class="doc-toc" aria-label="Table of contents">
          <span class="doc-toc__label">On this page</span>
          <ol>
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'toc-h3' : undefined}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </div>

  {
    showToc && (
      <script>
        const links = [...document.querySelectorAll('[data-toc-link]')];
        const map = new Map(
          links.map((a) => {
            const id = a.getAttribute('data-toc-link');
            return [id, a];
          })
        );

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const id = entry.target.id;
              links.forEach((a) => a.classList.remove('is-active'));
              map.get(id)?.classList.add('is-active');
            }
          },
          { rootMargin: '-20% 0px -65% 0px', threshold: [0, 1] }
        );

        for (const id of map.keys()) {
          const el = document.getElementById(id);
          if (el) observer.observe(el);
        }
      </script>
    )
  }
</BaseLayout>
