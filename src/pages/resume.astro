---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { resume } from '../data/resume';
import { absoluteUrl, profilePageSchema } from '../lib/schema';
---

<BaseLayout
  fullTitle={`${site.name} — Resume · ${site.title}`}
  description={`Resume of ${site.name} — Metocean Data Engineer, Backend Developer, and Metocean Practitioner. Experience, skills, and education.`}
  ogType="profile"
  schema={profilePageSchema(absoluteUrl('/resume/'))}
>
  <section class="site-shell page-hero">
    <h1>{site.name}</h1>
    <ul class="role-list" aria-label="Roles">
      {site.roles.map((role) => <li>{role}</li>)}
    </ul>
    <p style="margin: 0 0 0.85rem; color: var(--ink-muted); font-size: 0.95rem;">
      {site.location}
    </p>
    <p>{resume.summary}</p>
    <div class="cta-row" style="margin-top: 1.5rem;">
      <a class="btn btn--primary" href={`mailto:${site.email}`}>Contact me</a>
      <a class="btn btn--ghost" href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="btn btn--ghost" href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </section>

  <section class="site-shell resume-grid">
    <div class="resume-block">
      <h2>What I do</h2>
      <ul class="focus-list">
        {resume.focus.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="resume-block">
      <h2>Experience</h2>
      {
        resume.experience.map((job) => (
          <article class="job">
            <div class="job__meta">
              <p class="job__role">{job.role}</p>
              <p class="job__company">{job.company}</p>
              <p class="job__period">{job.period}</p>
            </div>
            {job.location && (
              <p style="margin: 0 0 0.35rem; color: var(--ink-muted); font-size: 0.9rem;">
                {job.location}
              </p>
            )}
            <ul>
              {job.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="resume-block">
      <h2>Skills</h2>
      <div class="skills">
        {
          Object.entries(resume.skills).map(([group, items]) => (
            <div class="skill-group">
              <h3>{group}</h3>
              <ul>
                {items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="resume-block">
      <h2>Education</h2>
      {
        resume.education.map((ed) => (
          <article class="job">
            <div class="job__meta">
              <p class="job__role">{ed.degree}</p>
              <p class="job__company">{ed.school}</p>
              <p class="job__period">{ed.period}</p>
            </div>
            {ed.detail && <p style="color: var(--ink-muted); margin: 0.35rem 0 0;">{ed.detail}</p>}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
