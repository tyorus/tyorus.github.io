---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';

const posts = (await getCollection('tutorials')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout
  title="Tutorials"
  description={`How-to notes by ${site.name} on wave modelling, GrADS, and metocean/data workflows.`}
>
  <section class="site-shell page-hero">
    <h1>Tutorials</h1>
    <p>Step-by-step notes for tools and workflows — installs, plotting, and reproducible setups.</p>
  </section>

  <section class="site-shell section">
    <div class="section__head">
      <h2 class="section__title">All tutorials</h2>
      <span class="section__link">{posts.length} guides</span>
    </div>
    {
      posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/tutorials/${post.id}`}>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <div>
                  <h3>
                    <span class="lang-badge lang-badge--inline">{post.data.lang === 'id' ? 'ID' : 'EN'}</span>
                    {post.data.title}
                  </h3>
                  <p>
                    {[...post.data.categories, ...post.data.tags.slice(0, 2)]
                      .filter((v, i, arr) => arr.indexOf(v) === i)
                      .join(' · ')}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p style="color: var(--ink-muted); margin: 0;">No tutorials yet.</p>
      )
    }
  </section>
</BaseLayout>
