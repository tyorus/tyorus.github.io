---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { resume } from '../data/resume';
import { homeGraphSchema } from '../lib/schema';
---

<BaseLayout home schema={homeGraphSchema()}>
  <section class="hero">
    <p class="hero__role">{site.roles.join(' · ')}</p>
    <h1 class="hero__brand">{site.title}</h1>
    <p class="hero__name">{site.name}</p>
    <p class="hero__lede">{site.tagline}</p>
    <ul class="hero__focus">
      {resume.focus.map((item) => <li>{item}</li>)}
    </ul>
    <p class="hero__bridge">{site.bridge}</p>
    <div class="cta-row">
      <a class="btn btn--primary" href={site.resumePdf} download="suwignyo-prasetyo-resume.pdf"
        >Download Resume</a
      >
      <a class="btn btn--ghost" href="/projects">View Engineering Work</a>
      <a class="btn btn--ghost" href="/services">Hire Me for Automation</a>
    </div>
  </section>
</BaseLayout>
