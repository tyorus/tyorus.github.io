---
import ContentDoc from '../../components/ContentDoc.astro';
import { getCollection, render } from 'astro:content';
import { forStaticPaths } from '../../lib/content';

export async function getStaticPaths() {
  const posts = forStaticPaths(await getCollection('projects'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<ContentDoc
  entry={post}
  Content={Content}
  headings={headings}
  section="projects"
  sectionLabel="projects"
/>
